{
  "name": "3tched.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "publish:op-web": "bash scripts/publish-op-web.sh",
    "type-check": "svelte-kit sync && tsc -b --pretty false && svelte-check --tsconfig ./tsconfig.app.json --config ./vite.config.ts",
    "prepare": "svelte-kit sync",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "proto:gen": "bash scripts/proto-gen.sh",
    "references:export": "vite build --config vite.references.config.ts && node scripts/export-dashboard-references.mjs",
    "3tched": "node bin/3tched.mjs"
  },
  "dependencies": {
    "@json-render/core": "^0.20.0",
    "@json-render/svelte": "^0.20.0",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "svelte": "^5.57.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "3tched SvelteKit chat: inline Json Render UI wired to the OP-DBUS :8090 door",
  "bin": {
    "3tched": "./bin/3tched.mjs"
  }
}
