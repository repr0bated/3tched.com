# ct-egress (host Xray client) may dial only the Xray exit VPS (209.74.79.180:443).
table inet ct_egress
delete table inet ct_egress
table inet ct_egress {
	chain out {
		type filter hook output priority filter; policy accept;
		meta skuid != "ct-egress" accept
		oifname "lo" accept
		ip daddr 209.74.79.180 tcp dport 443 accept
		reject
	}
}
