{
  "envelope_version": "SID1",
  "control_plane": "OP-DBUS / 3tched",
  "host_os": "Debian GNU/Linux (systemd, D-Bus Control)",
  "container_identity": {
    "name": "3tchedChatbot",
    "wireguard_pubkey": "wNhmhGDpdkScmSdcHnzhr/1vmTIL5wxLXcve/jwk9xE=",
    "kdf": {
      "algorithm": "BLAKE3-KDF",
      "domain_context": "opdbus.3tched.v1.session_kdf",
      "deterministic": true
    },
    "ids": "derived from wireguard_pubkey: instance name = derive_session_id, grants use derive_principal_id; the decoy issues the SID1 (IID1)"
  },
  "storage_attestation": {
    "outer_lv": {
      "device": "/dev/dm-3",
      "mount": "/run/mounts/seed-3tched",
      "size_gib": 40,
      "fs": "ext4"
    },
    "base_seed": {
      "image": "/dev/sda4 (UUID dcfbc0a6-442d-474f-b636-fe17d25eaaf1)",
      "size_gib": 16,
      "btrfstune_seed": true
    },
    "delta_sprout": {
      "image": "cozo_delta.img",
      "size_gib": 20,
      "mount_options": "rw,noatime,compress=zstd:3,space_cache=v2"
    },
    "cozo_rocksdb": {
      "image": "cozo_rocksdb.img",
      "mount": "/var/lib/rocksdb",
      "size_gib": 50,
      "fs": "ext4",
      "chattr_nocow": true,
      "mount_options": "rw,noatime,nodiratime,barrier=0"
    },
    "upgrade_staging": {
      "image": "cozo_upgrade_base.img",
      "mount": "/mnt/upgrade",
      "size_gib": 20,
      "read_only": true
    }
  },
  "agent_subvolumes": [
    {
      "path": "/agent/user",
      "mode": "rw",
      "files": [
        "session.json",
        "identity.json"
      ],
      "purpose": "Local anchored session state and cryptographic identity records"
    },
    {
      "path": "/agent/memory",
      "mode": "rw",
      "files": [
        "graph_manifest.cozo",
        "working_relations.db"
      ],
      "purpose": "Active episodic memory graphs and Datalog relation snapshots"
    },
    {
      "path": "/agent/skills",
      "mode": "rw",
      "files": [
        "registry.json",
        "sandbox_runner.wasm"
      ],
      "purpose": "Container-bound tool descriptors and execution models"
    },
    {
      "path": "/agent/soul",
      "mode": "ro",
      "files": [
        "persona.sealed.json",
        "axioms.datalog"
      ],
      "purpose": "Immutable agent persona, core axioms, and behavioral constitution"
    },
    {
      "path": "/agent/rules",
      "mode": "ro",
      "files": [
        "capabilities.sid1.json",
        "egress_allowlist.txt"
      ],
      "purpose": "Protocol policies, capability boundaries, and egress guards"
    },
    {
      "path": "/agent/shared",
      "mode": "ro",
      "files": [
        "3tched_types.schema.json",
        "opdbus_v1.proto"
      ],
      "purpose": "Read-only shared schema definitions and 3tchedFS type contracts"
    }
  ],
  "cozodb_bootstrap_relations": [
    ":create agent_identity { session_id: Uuid => principal_id: String, wg_pubkey: String, sid_version: String }",
    ":create agent_memory_node { node_id: Uuid, session_id: Uuid => kind: String, payload_json: String, ts: Float }",
    ":create lungs_audit_trail { seq: Int => op_path: String, arg_blake3: String, status: String, ts: Float }"
  ]
}
