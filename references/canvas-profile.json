{
  "format": "3tched.canvas-profile.v1",
  "limits": {
    "max_bytes": 200000,
    "max_elements": 256,
    "max_depth": 20
  },
  "components": [
    {
      "name": "dashboardPanel",
      "description": "Reusable titled dashboard panel for spec-composed content.",
      "slots": [
        "default"
      ],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 400
          },
          "subtitle": {
            "type": "string",
            "maxLength": 400
          },
          "tone": {
            "type": "string",
            "enum": [
              "neutral",
              "info",
              "success",
              "warning",
              "danger"
            ]
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardDisclosure",
      "description": "Expandable details region for static reference content.",
      "slots": [
        "default"
      ],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 400
          },
          "summary": {
            "type": "string",
            "maxLength": 400
          },
          "initiallyOpen": {
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardMetric",
      "description": "Metric value and explanatory detail.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 400
          },
          "value": {
            "type": "string",
            "maxLength": 400
          },
          "detail": {
            "type": "string",
            "maxLength": 400
          },
          "tone": {
            "type": "string",
            "enum": [
              "neutral",
              "info",
              "success",
              "warning",
              "danger"
            ]
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardKeyValues",
      "description": "Labeled configuration and identity facts.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 400
          },
          "rows": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 400
                },
                "value": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardTable",
      "description": "Read-only data table with caption and column headers.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "caption": {
            "type": "string",
            "maxLength": 400
          },
          "columns": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 400
                }
              },
              "required": [
                "id",
                "label"
              ]
            }
          },
          "rows": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 400
                },
                "cells": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 400
                  }
                }
              },
              "required": [
                "id",
                "cells"
              ]
            }
          },
          "emptyLabel": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "caption",
          "columns",
          "rows"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardTabs",
      "description": "Keyboard-accessible static reference tabs with text panels.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 400
          },
          "initialTab": {
            "type": "string",
            "maxLength": 400
          },
          "tabs": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 400
                },
                "label": {
                  "type": "string",
                  "maxLength": 400
                },
                "content": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "required": [
                "id",
                "label",
                "content"
              ]
            }
          }
        },
        "required": [
          "label",
          "tabs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardFormPreview",
      "description": "Disabled illustrative controls; no submit or backend action.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 400
          },
          "fields": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 400
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "email",
                    "number",
                    "textarea",
                    "select",
                    "toggle"
                  ]
                },
                "value": {
                  "type": "string",
                  "maxLength": 400
                },
                "options": {
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 400
                  }
                },
                "checked": {
                  "type": "boolean"
                },
                "help": {
                  "type": "string",
                  "maxLength": 400
                }
              },
              "required": [
                "id",
                "label",
                "type"
              ]
            }
          }
        },
        "required": [
          "title",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardProgress",
      "description": "Labeled completion or utilization meter.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 400
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "detail": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardBarChart",
      "description": "Accessible static percentage bars without a chart dependency.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
