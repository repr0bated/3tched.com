    {
      "name": "dashboardTopology",
      "description": "Static topology with an accessible node and edge list.",
      "slots": [],
      "props_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 400
          },
          "nodes": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 400
                },
                "label": {
                  "type": "string",
                  "maxLength": 400
                },
                "detail": {
                  "type": "string",
                  "maxLength": 400
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "id",
                "label",
                "x",
                "y"
              ]
            }
          },
          "edges": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "maxLength": 400
                },
                "to": {
                  "type": "string",
                  "maxLength": 400
                },
                "label": {
                  "type": "string",
                  "maxLength": 400
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          }
