            "type": "string",
            "maxLength": 400
          },
          "bars": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 400
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          }
        },
        "required": [
          "title",
          "bars"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dashboardEventLog",
