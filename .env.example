# Default TLS door origin, no path.
VITE_OPDBUS_DOOR=https://10.0.0.2:8090
# Browser identity pickup over the human's WireGuard tunnel to the decoy.
# The issuer must allow the UI origin, e.g. http://10.0.0.2:8080.
VITE_OPDBUS_ISSUER=http://10.0.0.1:51888

# ── Chat_Route → threetched (ZeroClaw) generation ──────────────────────────
# Loopback HTTP origin of the threetched gateway in the same container.
# When set, CHAT_ROUTE_PROVIDER=auto selects threetched; otherwise synthetic.
# THREETCHED_ENDPOINT=http://127.0.0.1:18789
# THREETCHED_AGENT_ALIAS=default
# THREETCHED_BEARER_TOKEN=
# CHAT_ROUTE_PROVIDER=auto

# ── Salad (threetched custom OpenAI-compat slot) ───────────────────────────
# Keys are consumed by threetched/ZeroClaw, not by Chat_Route or the UI.
# Prefer SALAD_AI_GATEWAY_API_KEY; SALAD_API_KEY is a fallback. Never commit a real key.
# See deploy/container/threetched.providers.example.toml for the custom.salad fragment.
# SALAD_AI_GATEWAY_API_KEY=
# SALAD_API_KEY=
# ZEROCLAW_providers__models__custom__salad__api_key=${SALAD_AI_GATEWAY_API_KEY:-$SALAD_API_KEY}
